# ARCDVNCLI Configuration Example
# Global settings are stored in ~/.arcdvncli_env

# Provider: 'google' (Google Gemini) or 'openrouter' (OpenRouter)
ARCDVN_PROVIDER=google

# Google Gemini Configuration (Default)
ARCDVN_GOOGLE_API_KEY=your_gemini_api_key_here
ARCDVN_MODEL=gemini-3.8-flash

# OpenRouter Configuration (Optional / Alternative)
# ARCDVN_OPENROUTER_API_KEY=your_openrouter_api_key_here
# ARCDVN_MODEL=google/gemini-2.5-flash

# Legacy Fallback Key (Supports both providers)
# ARCDVN_API_KEY=your_api_key_here

# Optional: Execution step limit (default: 30)
# ARCDVN_MAX_STEPS=30

# Optional: Custom Base URL (leave unset to use provider default)
# ARCDVN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
