# ARCDVNCLI Configuration Example
# Global settings are stored in ~/.arcdvncli_env
# Each provider maintains strictly isolated credentials, models, and endpoints.

# Active Provider: 'google', 'openai', 'anthropic', 'openrouter', 'groq', 'deepseek', 'nvidia', 'cerebras', 'custom'
ARCDVN_PROVIDER=google

# 1. Google Gemini Configuration (Default)
ARCDVN_GOOGLE_API_KEY=your_gemini_api_key_here
ARCDVN_GOOGLE_MODEL=gemini-3.8-flash

# 2. OpenAI Configuration
# ARCDVN_OPENAI_API_KEY=your_openai_api_key_here
# ARCDVN_OPENAI_MODEL=gpt-4o

# 3. Anthropic Claude Configuration (Native Messages API)
# ARCDVN_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ARCDVN_ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# 4. OpenRouter Configuration
# ARCDVN_OPENROUTER_API_KEY=your_openrouter_api_key_here
# ARCDVN_OPENROUTER_MODEL=google/gemini-2.5-flash

# 5. Groq Configuration
# ARCDVN_GROQ_API_KEY=your_groq_api_key_here
# ARCDVN_GROQ_MODEL=llama-3.3-70b-versatile

# 6. DeepSeek Configuration
# ARCDVN_DEEPSEEK_API_KEY=your_deepseek_api_key_here
# ARCDVN_DEEPSEEK_MODEL=deepseek-chat

# 7. Custom OpenAI-Compatible Endpoint (e.g. Ollama, vLLM, Local Server)
# ARCDVN_CUSTOM_API_KEY=your_custom_key_or_none
# ARCDVN_CUSTOM_BASE_URL=http://localhost:11434/v1
# ARCDVN_CUSTOM_MODEL=llama3

# Optional: Fallback Provider (Used if primary provider is temporarily unavailable)
# ARCDVN_FALLBACK_PROVIDER=openrouter

# Optional: Execution step limit (default: 30)
# ARCDVN_MAX_STEPS=30

# Optional: Detailed tool output diagnostics (1: enable, 0: disable)
# ARCDVNCLI_TOOL_DETAILS=0
